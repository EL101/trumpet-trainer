{
  "name": "trumpet-trainer",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix client\" \"npm run dev --prefix server\"",
    "db:up": "docker compose up -d --wait postgres && npm run db:migrate",
    "db:migrate": "docker compose run --rm migrate",
    "db:down": "docker compose down",
    "test": "vitest",
    "format": "eslint --fix . && prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "concurrently": "^9.2.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "express": "^5.2.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "prettier": "^3.8.3",
    "semantic-ui-react": "^2.1.5"
  }
}
