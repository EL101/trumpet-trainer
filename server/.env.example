# Local Postgres from docker-compose.yml at the repo root (npm run db:up).
DATABASE_URL="postgresql://trumpet:trumpet@localhost:5433/trumpet_trainer"

# Neon. Used only by `npm run migrate:prod`; the deployed server reads
# DATABASE_URL, so set this one to the Neon URL in the host's own environment.
NEON_DATABASE_URL=

# Optional. Used instead of DATABASE_URL for migrations when set. In production,
# the Neon URL without "-pooler" in the hostname. Unneeded for local Docker.
DIRECT_DATABASE_URL=

# Firebase service account, from the JSON private key file.
# Keep the \n escapes in the private key; src/firebase.ts unescapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to false to stop the hourly sweep that deletes idle guest accounts.
GUEST_SWEEP_ENABLED=

# Set to false to stop the hourly prune that trims each user's history to its
# newest 100 exercises.
HISTORY_PRUNE_ENABLED=

# Anthropic API key for etude generation. Without one, POST /api/etudes answers 503.
ANTHROPIC_API_KEY=

# Optional. The model that writes etudes; defaults to claude-haiku-5-5.
ETUDE_MODEL=

# Optional. Etudes per user in any 24 hours (default 10). Guests can't generate etudes.
ETUDE_DAILY_LIMIT=

# Optional. Total etude spend per UTC day, in dollars, after which etudes pause
# until midnight UTC (default 5). Set a monthly limit in the Anthropic Console too.
ETUDE_DAILY_SPEND_USD=

# Optional. On SIGTERM or SIGINT, how long etudes being written get to finish before
# they're marked interrupted and the server exits, in milliseconds (default 20000).
# Keep it well under the platform's wait before it kills the process.
ETUDE_SHUTDOWN_GRACE_MS=
