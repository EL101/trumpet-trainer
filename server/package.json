{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:local": "for f in migrations/*.sql; do echo \"applying $f\"; docker exec -i pg-dev psql -U postgres -d trumpet_trainer < \"$f\" || exit 1; done",
    "migrate:prod": "dotenv -e .env -- bash -c 'for f in migrations/*.sql; do echo \"applying $f\"; psql \"$NEON_DATABASE_URL\" -f \"$f\" || exit 1; done'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "camelcase-keys": "^10.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "pg": "^8.21.0",
    "prettier": "^3.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
