// Prisma models mirror the tables created by the SQL in migrations/.
// The DB is snake_case; @map keeps the generated client camelCase.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // For the one-pending-etude-per-user index on etude_generations.
  previewFeatures = ["partialIndexes"]

  // Emit ESM with explicit .js specifiers so the tsc output resolves under Node.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The kinds of exercise the generator makes. A Postgres enum, so the database
/// itself rejects any other value.
enum ExerciseType {
  LONG_TONES
  SCALES
  LIP_SLURS
  ETUDES
  RANDOM

  @@map("exercise_type")
}

/// One generated exercise, recorded as the user generates it. Each user keeps
/// their newest HISTORY_LIMIT rows; the hourly prune deletes the rest.
model History {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  /// The exercise itself, shared with its library row. Made by the client when it
  /// generates the exercise, so it survives renumbering; generated here otherwise.
  exerciseId    String       @default(dbgenerated("gen_random_uuid()")) @map("exercise_id") @db.Uuid
  exerciseType  ExerciseType @default(RANDOM) @map("exercise_type")
  notes         String
  timeSig       String       @map("time_sig")
  musicKey      String       @map("music_key")
  noteRange     String       @map("note_range")
  difficulty    String
  generationNum Int          @map("generation_num")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One row per generation: saving the same generation again is a no-op.
  @@unique([userId, generationNum], map: "uq_history_user_generation")
  @@map("history")
}

/// An exercise the user explicitly saved.
model Library {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  /// The exercise saved, matching its history row's exerciseId.
  exerciseId    String       @default(dbgenerated("gen_random_uuid()")) @map("exercise_id") @db.Uuid
  exerciseType  ExerciseType @default(RANDOM) @map("exercise_type")
  notes         String
  timeSig       String       @map("time_sig")
  musicKey      String       @map("music_key")
  noteRange     String       @map("note_range")
  difficulty    String
  generationNum Int          @map("generation_num")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Each exercise once: saving it again is a no-op.
  @@unique([userId, exerciseId], map: "uq_library_user_exercise")
  @@index([userId, createdAt(sort: Desc)], map: "idx_library_user_created")
  @@map("library")
}

/// Profile data. Identity still lives in Firebase Auth; email/displayName are
/// mirrored here from the ID token so exercise rows have something to point at.
model User {
  id          String   @id
  email       String?
  displayName String?  @map("display_name")
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  /// Refreshed at most hourly by ensureUserExists; drives the guest sweep.
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Exercises the user has generated, counted as each is saved to history. Kept
  /// here because history itself is pruned to its newest rows.
  exercisesGenerated Int @default(0) @map("exercises_generated")

  avatar           UserAvatar?
  settings         UserSettings?
  history          History[]
  library          Library[]
  etudeGenerations EtudeGeneration[]
  practiceScores   PracticeScore[]

  @@index([isAnonymous, lastSeenAt], map: "idx_users_anonymous_last_seen")
  @@map("users")
}

/// Where an etude request has got to. PENDING is being written, one per user at a
/// time, and holds the user's place in their daily quota meanwhile. FAILED rows
/// still cost money but don't use up the quota, since the user got nothing for them.
enum EtudeStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@map("etude_status")
}

/// One request to Claude for an etude. Drives the per-user daily quota and the
/// global daily spend cap, and records what each etude really cost.
model EtudeGeneration {
  id           String      @id @default(uuid())
  /// Null once the user has deleted their account. The row stays, since the spend cap
  /// counts it: deleting an account mustn't give back what its etudes cost.
  userId       String?     @map("user_id")
  status       EtudeStatus @default(PENDING)
  model        String
  inputTokens  Int         @default(0) @map("input_tokens")
  outputTokens Int         @default(0) @map("output_tokens")
  /// Millionths of a dollar, so sums stay exact. Until the etude is written, the
  /// most it can cost, so the spend cap counts etudes still being written.
  costMicros   Int         @default(0) @map("cost_micros")
  /// The history row the etude was saved as, once it succeeded.
  exerciseId   String?     @map("exercise_id") @db.Uuid
  /// Why it failed, worded for the player.
  error        String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// One etude being written per user at a time, enforced by the database, so two
  /// requests at once can't both start one (or both take the last of the quota).
  @@unique([userId], map: "uq_etude_generations_user_pending", where: raw("status = 'PENDING'"))
  @@index([userId, createdAt], map: "idx_etude_generations_user_created")
  @@index([createdAt], map: "idx_etude_generations_created")
  @@map("etude_generations")
}

/// Uploaded avatar bytes, split out so the hot users row stays small.
model UserAvatar {
  userId    String   @id @map("user_id")
  mimeType  String   @map("mime_type")
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// The user's own settings, at most one row each. A user without one has the
/// defaults, so nothing is written until they first save.
model UserSettings {
  userId    String   @id @map("user_id")
  /// What the Low, Medium and High ranges cover: the lowest and highest written
  /// note of each, as MIDI numbers. The SQL checks they're inside F#3–G6 and at
  /// least an octave apart, as the API does first.
  lowMin    Int      @map("low_min")
  lowMax    Int      @map("low_max")
  medMin    Int      @map("med_min")
  medMax    Int      @map("med_max")
  highMin   Int      @map("high_min")
  highMax   Int      @map("high_max")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

/// One scored run of an exercise in the player's Play mode: a 0–100 score for each
/// of the four things it judges, their weighted average, and the feedback written
/// under each. The player and the exercise cards show the newest one per exercise.
/// Rows are kept for the user's progress: the hourly prune only clears feedback.
model PracticeScore {
  id                 String       @id @default(uuid())
  userId             String       @map("user_id")
  /// The exercise played, as its history and library rows name it. Not a foreign
  /// key: an exercise can be in either table, or move from one to the other, and its
  /// scores outlive it (the user's progress).
  exerciseId         String       @map("exercise_id") @db.Uuid
  /// What the exercise was, copied from its row when the run was saved, so the score
  /// still says what was played once the exercise is gone.
  exerciseType       ExerciseType @map("exercise_type")
  timeSig            String       @map("time_sig")
  musicKey           String       @map("music_key")
  noteRange          String       @map("note_range")
  difficulty         String
  /// Beats per minute the run was played at.
  tempo              Int
  overall            Int
  rightNotesScore    Int          @map("right_notes_score")
  rhythmScore        Int          @map("rhythm_score")
  intonationScore    Int          @map("intonation_score")
  toneScore          Int          @map("tone_score")
  /// Each a list of `{ bar, text, … }` notes, as `ScoreNoteSchema` describes. All four
  /// are cleared (null) once the run's feedback is let go: its exercise is gone, or
  /// it's past the exercise's newest scores. The scores above stay.
  rightNotesFeedback Json?        @map("right_notes_feedback")
  rhythmFeedback     Json?        @map("rhythm_feedback")
  intonationFeedback Json?        @map("intonation_feedback")
  toneFeedback       Json?        @map("tone_feedback")
  /// When the hourly prune found the run's exercise in neither history nor the library.
  /// Its feedback is cleared on a later prune if the exercise is still gone, and the mark
  /// taken off if it's back (history cleared and the exercise saved again). Only while
  /// there's feedback to clear.
  feedbackOrphanedAt DateTime?    @map("feedback_orphaned_at") @db.Timestamptz(6)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId, createdAt(sort: Desc)], map: "idx_practice_scores_user_exercise_created")
  /// A user's runs by when, for the rate limit's counts of the last minute and day.
  @@index([userId, createdAt(sort: Desc)], map: "idx_practice_scores_user_created")
  /// Only runs that still have feedback: the newest read back, and the prune's search.
  @@index([userId, exerciseId, createdAt(sort: Desc)], map: "idx_practice_scores_with_feedback", where: raw("right_notes_feedback IS NOT NULL"))
  /// Only the runs marked as orphaned, which are few: the prune's search for them.
  @@index([feedbackOrphanedAt], map: "idx_practice_scores_orphaned", where: raw("feedback_orphaned_at IS NOT NULL"))
  @@map("practice_scores")
}
