// Prisma models mirror the tables created by the SQL in migrations/.
// The DB is snake_case; @map keeps the generated client camelCase.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Emit ESM with explicit .js specifiers so the tsc output resolves under Node.
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// One generated exercise, recorded as the user generates it.
model History {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  notes         String
  timeSig       String   @map("time_sig")
  musicKey      String   @map("music_key")
  noteRange     String   @map("note_range")
  difficulty    String
  generationNum Int      @map("generation_num")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generationNum(sort: Desc)], map: "idx_history_user_generation")
  @@map("history")
}

/// An exercise the user explicitly saved.
model Library {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  notes         String
  timeSig       String   @map("time_sig")
  musicKey      String   @map("music_key")
  noteRange     String   @map("note_range")
  difficulty    String
  generationNum Int      @map("generation_num")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_library_user_created")
  @@map("library")
}

/// Profile data. Identity still lives in Firebase Auth; email/displayName are
/// mirrored here from the ID token so exercise rows have something to point at.
model User {
  id          String   @id
  email       String?
  displayName String?  @map("display_name")
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  avatar  UserAvatar?
  history History[]
  library Library[]

  @@map("users")
}

/// Uploaded avatar bytes, split out so the hot users row stays small.
model UserAvatar {
  userId    String   @id @map("user_id")
  mimeType  String   @map("mime_type")
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}
